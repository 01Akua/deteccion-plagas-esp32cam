{
  "version": 1,
  "author": "Luis Palacios",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-pir-motion-sensor", "id": "pir", "top": -120, "left": 160, "attrs": {} },
    { "type": "wokwi-led", "id": "led", "top": 60, "left": 240, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 130, "left": 235, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "pir:VCC", "esp:5V", "red", [ "v0" ] ],
    [ "pir:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "pir:OUT", "esp:13", "green", [ "v0" ] ],
    [ "esp:2", "led:A", "orange", [ "h0" ] ],
    [ "led:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.3", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
